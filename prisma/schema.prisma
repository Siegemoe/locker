generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
  AI_TOOL
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityActorType {
  USER
  AI_TOOL
  SYSTEM
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum ArtifactKind {
  LINK
  TEXT
  FILE_METADATA
}

enum JournalEntryStatus {
  OPEN
  FINALIZED
}

enum JournalRole {
  REFLECTION
  USER_DECISION
  AGENT_OBSERVATION
  AGENT_HYPOTHESIS
  AGENT_RECOMMENDATION
  OBJECTIVE_ACTIVITY
}

enum JournalCandidateKind {
  DECISION
  REALIZATION
  MILESTONE
  DIRECTION_CHANGE
  ABANDONED_ASSUMPTION
  IDEA
  DISAGREEMENT
  FAILURE
  CHANGE_OF_MIND
  COMPLETION
  EVIDENCE
}

model User {
  id          String            @id @default(uuid()) @db.Uuid
  externalId  String?           @unique
  email       String?           @unique
  displayName String
  memberships WorkspaceMember[]
  activities  Activity[]        @relation("ActivityUser")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  name        String
  description String?
  members     WorkspaceMember[]
  projects    Project[]
  tasks       Task[]
  tags        Tag[]
  artifacts   Artifact[]
  journalEntries JournalEntry[]
  activities  Activity[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String?
  tasks       Task[]
  journalContributions JournalContributionProject[]
  journalCandidates JournalCandidate[]
  activities  Activity[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  projectId       String?          @db.Uuid
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus       @default(BACKLOG)
  priority        TaskPriority     @default(MEDIUM)
  position        Int              @default(0)
  dueAt           DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdBy       String?
  version         Int              @default(1)
  dependencies    TaskDependency[] @relation("DependentTask")
  dependents      TaskDependency[] @relation("BlockingTask")
  activities      Activity[]
  tags            TaskTag[]
  artifacts       Artifact[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?

  @@index([workspaceId, status, position])
  @@index([projectId, status, position])
  @@index([dueAt])
}

model Tag {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  tasks       TaskTag[]
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
}

model TaskTag {
  taskId    String   @db.Uuid
  tagId     String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, tagId])
  @@index([tagId])
}

model Artifact {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  taskId      String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind        ArtifactKind
  title       String
  url         String?
  textContent String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  storageKey  String?
  createdBy   String
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  @@index([taskId, archivedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model TaskDependency {
  taskId       String         @db.Uuid
  dependsOnId  String         @db.Uuid
  type         DependencyType @default(BLOCKS)
  task         Task           @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task           @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@id([taskId, dependsOnId, type])
  @@index([dependsOnId])
}

model JournalEntry {
  id            String             @id @default(uuid()) @db.Uuid
  workspaceId   String             @db.Uuid
  entryDate     DateTime           @db.Date
  title         String
  subtitle      String?
  status        JournalEntryStatus @default(OPEN)
  version       Int                @default(1)
  finalizedAt   DateTime?
  finalizedBy   String?
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contributions JournalContribution[]
  candidates    JournalCandidate[]
  activities    Activity[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([workspaceId, entryDate])
  @@index([workspaceId, entryDate(sort: Desc)])
}

model JournalContribution {
  id               String                       @id @default(uuid()) @db.Uuid
  entryId          String                       @db.Uuid
  authorKey        String
  authorLabel      String
  modelId          String?
  role             JournalRole                  @default(REFLECTION)
  bodyMarkdown     String
  topics           String[]
  importance       Int                          @default(3)
  sourceReferences Json?
  version          Int                          @default(1)
  entry            JournalEntry                 @relation(fields: [entryId], references: [id], onDelete: Cascade)
  projects         JournalContributionProject[]
  revisions        JournalContributionRevision[]
  activities       Activity[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([entryId, authorKey])
  @@index([authorKey, updatedAt(sort: Desc)])
  @@index([importance])
}

model JournalContributionProject {
  contributionId String              @db.Uuid
  projectId      String              @db.Uuid
  contribution   JournalContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@id([contributionId, projectId])
  @@index([projectId])
}

model JournalContributionRevision {
  id               String              @id @default(uuid()) @db.Uuid
  contributionId   String              @db.Uuid
  version          Int
  authorLabel      String
  modelId          String?
  role             JournalRole
  bodyMarkdown     String
  topics           String[]
  importance       Int
  sourceReferences Json?
  createdBy        String
  contribution     JournalContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())

  @@unique([contributionId, version])
  @@index([contributionId, createdAt(sort: Desc)])
}

model JournalCandidate {
  id               String               @id @default(uuid()) @db.Uuid
  entryId          String               @db.Uuid
  projectId        String?              @db.Uuid
  authorKey        String
  authorLabel      String
  modelId          String?
  kind             JournalCandidateKind
  summary          String
  contextMarkdown  String?
  importance       Int                  @default(3)
  sourceReferences Json?
  consumedAt       DateTime?
  entry            JournalEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activities       Activity[]
  createdAt        DateTime             @default(now())

  @@index([entryId, createdAt])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([authorKey, createdAt(sort: Desc)])
}

model Activity {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  projectId   String?           @db.Uuid
  taskId      String?           @db.Uuid
  actorUserId String?           @db.Uuid
  tagId       String?           @db.Uuid
  artifactId  String?           @db.Uuid
  journalEntryId String?        @db.Uuid
  journalContributionId String? @db.Uuid
  journalCandidateId String?    @db.Uuid
  actorType   ActivityActorType
  actorLabel  String
  action      String
  summary     String
  metadata    Json?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorUser   User?             @relation("ActivityUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  tag         Tag?              @relation(fields: [tagId], references: [id], onDelete: SetNull)
  artifact    Artifact?         @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journalContribution JournalContribution? @relation(fields: [journalContributionId], references: [id], onDelete: SetNull)
  journalCandidate JournalCandidate? @relation(fields: [journalCandidateId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([tagId, createdAt(sort: Desc)])
  @@index([artifactId, createdAt(sort: Desc)])
  @@index([journalEntryId, createdAt(sort: Desc)])
  @@index([journalContributionId, createdAt(sort: Desc)])
  @@index([journalCandidateId, createdAt(sort: Desc)])
}
