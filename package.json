{
  "name": "spore-locker",
  "version": "0.6.0",
  "description": "Local-first planning, task context, and multi-agent journal for AI-assisted software work.",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "setup:local": "node scripts/configure-local-env.mjs",
    "mcp:stdio": "tsx --env-file=.env src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/http-server.ts",
    "journal": "tsx scripts/journal-cli.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify:lifecycle": "tsx --env-file-if-exists=.env scripts/verify-lifecycle.ts",
    "verify:mcp": "tsx --env-file-if-exists=.env scripts/verify-mcp.ts",
    "verify:journal": "tsx --env-file-if-exists=.env scripts/verify-journal.ts",
    "verify:compose": "tsx scripts/verify-compose-flow.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "check": "pnpm lint && pnpm typecheck",
    "check:repo": "node scripts/check-repository-safety.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.0",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.2",
    "prisma": "^6.19.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
